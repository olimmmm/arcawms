{
  "name": "arcawms",
  "version": "1.1.0",
  "type": "module",
  "description": "ArcaWMS - MTG Chaos-Sorting Warehouse Management System",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run dev:client\"",
    "dev:client": "vite --host --port 5173",
    "server": "tsx server/server.ts",
    "start": "tsx server/server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview --host --port 5173"
  },
  "keywords": ["mtg", "wms", "chaos-sorting", "warehouse-management", "magic-the-gathering"],
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
